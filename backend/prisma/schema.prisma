generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  password     String
  fullName     String        @map("full_name")
  role         Role          @default(cashier)
  createdAt    DateTime      @default(now()) @map("created_at")
  transactions Transaction[]

  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String?   @db.Text
  products    Product[]

  @@map("categories")
}

model Product {
  id           Int                 @id @default(autoincrement())
  categoryId   Int                 @map("category_id")
  name         String
  description  String?             @db.Text
  costPrice    Decimal             @map("cost_price") @db.Decimal(10, 2)
  sellingPrice Decimal             @map("selling_price") @db.Decimal(10, 2)
  imageUrl     String?             @map("image_url")
  isBundle     Boolean             @default(false) @map("is_bundle")
  stock        Int                 @default(0)
  createdAt    DateTime            @default(now()) @map("created_at")
  inventory    Inventory[]
  category     Category            @relation(fields: [categoryId], references: [id])
  stockLogs    StockLog[]
  details      TransactionDetail[]
  bundleItems  BundleItem[]        @relation("BundleParent")
  asBundleItem BundleItem[]        @relation("BundleChild")

  @@index([categoryId])
  @@map("products")
}

model BundleItem {
  id        Int @id @default(autoincrement())
  bundleId  Int @map("bundle_id")
  productId Int @map("product_id")
  quantity  Int @default(1)

  bundle  Product @relation("BundleParent", fields: [bundleId], references: [id])
  product Product @relation("BundleChild", fields: [productId], references: [id])

  @@map("bundle_items")
}

model Inventory {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  stockQuantity Int      @map("stock_quantity")
  minStockAlert Int      @map("min_stock_alert")
  lastUpdated   DateTime @updatedAt @map("last_updated")
  product       Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("inventory")
}

model Transaction {
  id              Int                 @id @default(autoincrement())
  transactionCode String              @unique @map("transaction_code")
  userId          Int                 @map("user_id")
  subtotal        Decimal             @db.Decimal(10, 2)
  discount        Decimal             @db.Decimal(10, 2)
  totalAmount     Decimal             @map("total_amount") @db.Decimal(10, 2)
  paymentMethod   PaymentMethod       @map("payment_method")
  amountReceived  Decimal?            @map("amount_received") @db.Decimal(10, 2)
  amountChange    Decimal?            @map("amount_change") @db.Decimal(10, 2)
  createdAt       DateTime            @default(now()) @map("created_at")
  details         TransactionDetail[]
  user            User                @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("transactions")
}

model TransactionDetail {
  id            Int         @id @default(autoincrement())
  transactionId Int         @map("transaction_id")
  productId     Int         @map("product_id")
  quantity      Int
  unitPrice     Decimal     @map("unit_price") @db.Decimal(10, 2)
  totalPrice    Decimal     @map("total_price") @db.Decimal(10, 2)
  notes         String?     @db.Text
  product       Product     @relation(fields: [productId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@index([productId])
  @@index([transactionId])
  @@map("transaction_details")
}

model StockLog {
  id        Int          @id @default(autoincrement())
  productId Int          @map("product_id")
  type      StockLogType
  quantity  Int
  notes     String?      @db.Text
  createdAt DateTime     @default(now()) @map("created_at")
  product   Product      @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("stock_logs")
}

enum Role {
  admin
  cashier
}

enum PaymentMethod {
  cash
  qris
}

enum StockLogType {
  in
  out
}
